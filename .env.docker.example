# Dhaaga Bazaar — Docker Compose configuration template.
#
#   cp .env.docker.example .env.docker     (never commit .env.docker — it is git-ignored)
#
# Used twice by Compose: for ${...} interpolation (pass --env-file .env.docker) and as the
# API container's environment. The web (nginx) container receives NONE of these values.
# Use letters, digits, '-' and '_' in passwords (they are placed inside a database URL).

# ── PostgreSQL (container "db", never published to the host by default) ──────
POSTGRES_USER=dhaaga
POSTGRES_PASSWORD=CHANGE_ME_long_random_database_password
POSTGRES_DB=dhaaga_bazaar

# ── Web entry point ─────────────────────────────────────────────────────────
# Host interface and port for the web container. 127.0.0.1 = this machine only.
# Behind a TLS reverse proxy / load balancer on a server, keep 127.0.0.1 and proxy to it.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# ── API ─────────────────────────────────────────────────────────────────────
# Public origin(s) the browser uses (comma-separated) and the URL used in emails/reset links.
CLIENT_ORIGIN=https://www.example.com
APP_URL=https://www.example.com
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_96_hex_characters
SESSION_DAYS=7
MAX_UPLOAD_MB=8
RATE_LIMIT_API=600
LOGIN_FAILURES_PER_ACCOUNT=10
# Local testing on http://localhost only (relaxes the https/localhost checks, nothing else):
# ALLOW_INSECURE_LOCALHOST=true
# CLIENT_ORIGIN=http://localhost:8080
# APP_URL=http://localhost:8080

# ── First admin (used by the seed step only; remove after the first run) ─────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dhaaga Admin

# ── Dhaaga Bazaar AI Studio (Google Gemini) — API container only ─────────────
# Never use a VITE_ variable for this. Image editing needs a billing-enabled project.
GEMINI_API_KEY=CHANGE_ME
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_IMAGE_SIZE=2K
GEMINI_TIMEOUT_MS=180000
AI_DAILY_GENERATIONS=20
AI_DAILY_ANALYSES=60

# Development fixtures can never be shown in production; leave unset.
# ENABLE_DEV_FIXTURES=

# ── Razorpay (online payments) ──────────────────────────────
# Server-side only. Start with TEST keys (rzp_test_…) from Razorpay Dashboard → Account & Settings → API Keys.
# Live keys (rzp_live_…) are refused unless RAZORPAY_ALLOW_LIVE=true. See docs/PAYMENTS.md.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Secret you choose when adding the webhook (Dashboard → Webhooks) for https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_ALLOW_LIVE=false
