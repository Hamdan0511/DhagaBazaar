# ── Database ────────────────────────────────────────────────
# Local dev cluster created by `npm run db:init` at the repo root. Replace CHANGE_ME with a
# password of your choice before the first `npm run setup`; db:init creates the cluster with it.
DATABASE_URL="postgresql://dhaaga:CHANGE_ME@127.0.0.1:5433/dhaaga_bazaar?schema=public"

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173
# Public URL used in password-reset links.
APP_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# ── Storage ─────────────────────────────────────────────────
# "local" stores uploads in server/uploads. An S3-compatible adapter can be added in src/lib/storage.ts.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ── Development admin (seed only; never exposed through public registration) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dhaaga Admin

# ── Development fixtures ────────────────────────────────────
# When true (and NODE_ENV != production), clearly-labelled fixture listings are visible.
ENABLE_DEV_FIXTURES=false

# ── Single-process deployment ───────────────────────────────
# Serve the built client from this server (run `npm run build` at the repo root first).
SERVE_CLIENT=false
# CLIENT_DIST=../client/dist

# ── Security / rate limiting ────────────────────────────────
# Reverse-proxy hops in front of the API (1 behind a single load balancer). 0 = ignore X-Forwarded-For.
TRUST_PROXY=0
# Requests per IP per 5 minutes across the API.
RATE_LIMIT_API=600
# Sign-in/registration/reset attempts per IP per 15 minutes (default 30 in production, 300 otherwise).
# AUTH_ATTEMPTS_PER_IP=30
# Failed sign-ins allowed per account per 15 minutes, from any IP.
LOGIN_FAILURES_PER_ACCOUNT=10

# ── Email ───────────────────────────────────────────────────
# Not wired yet. Until set, password-reset links are only logged in development.
# EMAIL_PROVIDER=

# ── Dhaaga Bazaar AI Studio (Google Gemini) ─────────────────
# Server-side only. Never put this in a VITE_ variable or commit a real key.
# Create a key at https://aistudio.google.com/apikey. Image editing needs a project with billing
# enabled: on the free tier the image models have a quota of 0 and every generation is refused.
GEMINI_API_KEY=CHANGE_ME
# Image-editing model (image + text in → image out) and the vision model used for garment analysis.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# Output size requested from the image model: 1K, 2K or 4K (larger = slower and more expensive).
GEMINI_IMAGE_SIZE=2K
GEMINI_TIMEOUT_MS=180000
# Cost protection: per supplier, rolling 24 hours.
AI_DAILY_GENERATIONS=20
AI_DAILY_ANALYSES=60

# ── Razorpay (online payments) ──────────────────────────────
# Server-side only. Start with TEST keys (rzp_test_…) from Razorpay Dashboard → Account & Settings → API Keys.
# Live keys (rzp_live_…) are refused unless RAZORPAY_ALLOW_LIVE=true. See docs/PAYMENTS.md.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Secret you choose when adding the webhook (Dashboard → Webhooks) for https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_ALLOW_LIVE=false
