NODE_ENV=test
# Same database server and password as DATABASE_URL in server/.env. Each test run creates and
# drops its own dhaaga_test_run_<timestamp> database; the database named here is never modified.
DATABASE_URL="postgresql://dhaaga:CHANGE_ME@127.0.0.1:5433/dhaaga_bazaar_test?schema=public"
JWT_SECRET=test-only-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads-test
ENABLE_DEV_FIXTURES=false
